{{- /* Full-content RSS: <content:encoded> carries whole posts, since the */ -}}
{{- /* auto summary embeds raw KaTeX markup that readers show as garbage. */ -}}
{{- $pages := where (cond .IsHome site.RegularPages .RegularPages) "Section" "blog" -}}
{{- with site.Config.Services.RSS.Limit -}}
  {{- if ge . 1 }}{{ $pages = first . $pages }}{{ end -}}
{{- end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ if not .IsHome }}{{ .Title }} on {{ end }}{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Recent content {{ if not .IsHome }}in {{ .Title }} {{ end }}on {{ site.Title }}</description>
    <generator>Hugo</generator>
    {{- with site.Language.Locale }}
      <language>{{ . }}</language>
    {{- end }}
    {{- /* No managingEditor/webMaster/author: RSS 2.0 requires them to be */ -}}
    {{- /* email addresses, and publishing one is not worth spec compliance. */ -}}
    {{- with site.Copyright }}
      <copyright>{{ . }}</copyright>
    {{- end }}
    {{- range first 1 $pages }}
      {{- with .Date }}
        <lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
      {{- end }}
    {{- end }}
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{- range $pages }}
      <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
        <guid>{{ .Permalink }}</guid>
        <description>
          {{- with .Description | default .Summary -}}
            {{ . | plainify | htmlUnescape | truncate 300 }}
          {{- end -}}
        </description>
        <content:encoded>{{ printf "<![CDATA[%s]]>" .Content | safeHTML }}</content:encoded>
      </item>
    {{- end }}
  </channel>
</rss>
